# legacy/ keeps old versions and handoff files (zip, patches) on this computer only.
legacy/*

# macOS
.DS_Store
.AppleDouble
.LSOverride
# Finder's folder-icon file is named Icon followed by a carriage return.
# The bracket keeps names such as icons/ from being ignored on macOS, where Git ignores letter case.
Icon[!a-zA-Z0-9._-]
._*

# Windows and WSL
Thumbs.db
[Dd]esktop.ini
# Copying a downloaded file into WSL from Windows can leave a "<name>:Zone.Identifier" file next to it.
*:Zone.Identifier

# Editors
.vscode/
.idea/
*.code-workspace

# Logs and temporary files
*.log
*.swp
*.tmp
*.temp
*.bak
*.orig
*.rej
